---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

/**
 * The header: wordmark, the six game hubs, search.
 *
 * The design lays this out as a three-column grid — brand, centred links, and
 * an empty spacer — and the spacer is where the search box goes. Search was
 * dropped from the nav during the design pass for a cleaner header, but both
 * briefs call it non-negotiable for a reference site, so it is built back in
 * here, in the slot the design already left open, rather than by rearranging
 * the header.
 */
interface Props {
  current?: string;
}

const { current } = Astro.props;

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
---

<nav class="nav">
  <a class="nav__brand" href={withBase('/')}>IGA</a>

  <div class="nav__links">
    {
      games.map((game) => (
        <a
          class:list={['nav__link', { 'nav__link--current': current === game.id }]}
          href={withBase(`/${game.id}/`)}
          aria-current={current === game.id ? 'page' : undefined}
        >
          <span class="nav__dot" style={`background:${game.data.accent}`} aria-hidden="true" />
          {game.data.shortTitle}
        </a>
      ))
    }
  </div>

  <form class="nav__search" action={withBase('/search/')} method="get" role="search">
    <label class="nav__search-label" for="nav-search">Search the archive</label>
    <input
      class="nav__search-input"
      id="nav-search"
      type="search"
      name="q"
      placeholder="Search…"
      autocomplete="off"
    />
  </form>
</nav>

<style>
  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 22px;
    row-gap: 10px;
    padding: 13px 32px;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-divider);
    font-family: var(--font-body);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .nav__brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 21px;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--color-text);
    justify-self: start;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-dim);
    text-decoration: none;
    font-size: 14px;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }

  .nav__link:hover {
    color: var(--color-text);
  }

  .nav__link--current {
    color: var(--color-text);
    border-bottom-color: var(--color-accent);
  }

  .nav__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1px solid var(--color-divider);
    flex: none;
  }

  .nav__search {
    justify-self: end;
  }

  .nav__search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .nav__search-input {
    background: var(--color-surface);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 13px;
    padding: 5px 10px;
    width: 150px;
  }

  .nav__search-input::placeholder {
    color: var(--color-text-dim);
  }

  .nav__search-input:hover {
    border-color: var(--color-accent-dim);
  }

  /* Below the wide breakpoint the three columns stop fitting on one line:
     brand and search share the top row, the game links take the second.
     Both rows are placed explicitly — source order would otherwise push the
     search box onto a third row of its own, below the links. */
  @media (max-width: 860px) {
    .nav {
      grid-template-columns: 1fr auto;
      padding-inline: 20px;
    }

    .nav__links {
      grid-row: 2;
      grid-column: 1 / -1;
      gap: 14px;
      justify-content: flex-start;
    }

    .nav__search {
      grid-row: 1;
      grid-column: 2;
    }

    .nav__search-input {
      width: 140px;
    }
  }
</style>
