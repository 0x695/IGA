---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StatusDot from '../components/StatusDot.astro';
import EngineCard from '../components/EngineCard.astro';
import CommunityCard from '../components/CommunityCard.astro';
import { withBase } from '../lib/url';
import { formatStatus, formatLabel } from '../lib/formats';

/**
 * A game hub. Self-contained by design (masterdoc §10): it shows the engine
 * projects, format status and community links for *this* game, filtered out of
 * the shared collections. There are no standalone Engine Hub / Format
 * Reference / Community Directory pages — that structure was tried and
 * rejected during design for fragmenting attention away from the game the
 * visitor came for.
 */
export async function getStaticPaths() {
  const games = await getCollection('games');
  const projects = await getCollection('engineProjects');
  const formats = await getCollection('fileFormats');
  const links = await getCollection('communityLinks');

  const buildings = await getCollection('buildings');
  const missions = await getCollection('campaigns');

  return games.map((game) => ({
    params: { game: game.id },
    props: {
      game,
      projects: projects.filter((p) => p.data.games.includes(game.id)),
      formats: formats.filter((f) => f.data.games.includes(game.id)),
      links: links.filter((l) => l.data.games.includes(game.id)),
      buildingCount: buildings.filter((b) => b.data.variants.some((v) => v.game === game.id)).length,
      missionCount: missions.filter((m) => m.data.game === game.id).length,
    },
  }));
}

const { game, projects, formats, links, buildingCount, missionCount } = Astro.props;
const g = game.data;

/*
 * Credits arrive as one flat list of roles carrying an optional section, and
 * are grouped here in the order they appear. A credit list is not always one
 * team: Emperor was built by BreakAway Games for Impressions and credits the
 * two studios separately, and an expansion ships credits of its own. Flatten
 * those into a single run of roles and the reader is told, wrongly, that one
 * team did all of it.
 */
/*
 * What the campaign link says, per game. The six are not the same kind of
 * thing - Caesar has ranks and no fixed maps, Caesar II a province map with no
 * order, Zeus adventures made of episodes - and one sentence written for
 * Pharaoh described all of them wrongly.
 */
const CAMPAIGN_LINK: Record<string, { label: string; note: string }> = {
  caesar1: {
    label: '19 ranks',
    note: 'The promotion ladder, and the minimum and average ratings each rank demands. Caesar generates its provinces, so the ladder is the campaign.',
  },
  caesar2: {
    label: '32 provinces',
    note: 'Every province the game can hand you, and why they are not a sequence - you civilize outward from Latium in an order of your own.',
  },
  caesar3: {
    label: '20 missions',
    note: 'Every mission across eleven ranks, with the peaceful and military province each rank after the second offers you.',
  },
  pharaoh: {
    label: '53 missions',
    note: 'Every mission in play order, with the rank you hold and the win criteria the engine actually checks.',
  },
  zeus: {
    label: '13 adventures',
    note: 'Seven adventures and the six Poseidon adds, with the episodes inside each - including the colony choices that make a played run shorter than the list.',
  },
  emperor: {
    label: '48 missions',
    note: 'Every mission in play order, grouped by the dynasty it belongs to, from the Xia tutorials to the Song-Jin.',
  },
};
const campaignLink = CAMPAIGN_LINK[game.id];

const creditGroups: { section: string | null; rows: { role: string; names: string[] }[] }[] = [];
for (const row of g.fullCredits ?? []) {
  const section = row.section ?? null;
  const last = creditGroups.at(-1);
  if (last && last.section === section) last.rows.push(row);
  else creditGroups.push({ section, rows: [row] });
}
---

<Base title={`${g.title} — Impressions Games Archive`} description={g.engineNote} current={game.id}>
  <div data-pagefind-body>
    <section class="section hero">
      <div class="hero__meta">
        <span class="hero__dot" style={`background:${g.accent}`} aria-hidden="true"></span>
        <span class="hero__kicker">{g.years} · {g.civ}</span>
        {g.archive && <span class="pill">Archive entry</span>}
      </div>

      <h1 class="hero__title" style={`border-bottom-color:${g.accent}`}>{g.title}</h1>

      <dl class="facts">
        <div><dt>Setting</dt><dd>{g.setting}</dd></div>
        <div><dt>Developer</dt><dd>{g.developer}</dd></div>
        <div><dt>Publisher</dt><dd>{g.publisher}</dd></div>
        {g.expansions && (
          <div><dt>Expansions</dt><dd>{g.expansions}</dd></div>
        )}
      </dl>

      {g.credits && <p class="hero__credits">{g.credits}</p>}
      <p class="hero__note">{g.engineNote}</p>
    </section>

    <section class="section shot">
      <figure class="shot__figure">
        <img src={withBase(g.image)} alt={`${g.title} screenshot`} loading="lazy" />
        <figcaption>{g.imageCredit}</figcaption>
      </figure>
    </section>

    {
      g.fullCredits && (
        <section class="section block">
          <h2 class="section-heading">Credits</h2>
          {creditGroups.map((group) => (
            <>
              {group.section && <h3 class="credits__section">{group.section}</h3>}
              <dl class="credits">
                {group.rows.map((entry) => (
                  <div class="credits__row">
                    <dt>{entry.role}</dt>
                    <dd>{entry.names.join(', ')}</dd>
                  </div>
                ))}
              </dl>
            </>
          ))}
          <p class="credits__meta">
            {g.creditsNote && <span>{g.creditsNote} </span>}
            {g.creditsSources && (
              <>
                Transcribed from{' '}
                {g.creditsSources.map((source, index) => (
                  <>
                    {index > 0 && <span> and </span>}
                    {source.url ? (
                      <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>
                    ) : (
                      <span>{source.title}</span>
                    )}
                  </>
                ))}.
              </>
            )}
          </p>
        </section>
      )
    }

    <section class="section block">
      <h2 class="section-heading">File formats</h2>
      <div class="rule-list">
        {
          formats.map((format) => (
            <div class="format">
              <div class="format__label">
                {/* A format links to its own page only when there is a written
                    spec behind it. The rest state their situation and stop —
                    a link that leads to "nobody has documented this" wastes
                    the click that the arrow promised was worth making. */}
                {format.data.spec ? (
                  <a class="format__link" href={withBase(`/formats/${format.id}/`)}>
                    {format.data.name} →
                  </a>
                ) : (
                  <span class="format__name">{format.data.name}</span>
                )}
                <span class="format__note">{format.data.note}</span>
              </div>
              <StatusDot
                status={formatStatus(format.data.documentation)}
                label={formatLabel(format.data.documentation)}
              />
            </div>
          ))
        }
      </div>
    </section>

    {/* A hundred cards would bury this page, so the hub carries the count and
        the reference lives on its own route — the same shape as the format
        pages. Only shown for games whose buildings are actually populated. */}
    {
      buildingCount > 0 && (
        <section class="section block">
          <h2 class="section-heading">Buildings</h2>
          <a class="buildings-link" href={withBase(`/${game.id}/buildings/`)}>
            <span class="buildings-link__count">{buildingCount} buildings →</span>
            <span class="buildings-link__note">
              Every building the engine defines, with its footprint in tiles and the constant that
              names it in the source. Filterable by name or category.
            </span>
          </a>
        </section>
      )
    }

    {
      missionCount > 0 && (
        <section class="section block">
          <h2 class="section-heading">Campaign</h2>
          <a class="buildings-link" href={withBase(`/${game.id}/campaign/`)}>
            <span class="buildings-link__count">{campaignLink.label} -></span>
            <span class="buildings-link__note">{campaignLink.note}</span>
          </a>
        </section>
      )
    }

    <section class="section block">
      <h2 class="section-heading">Open-source engines</h2>

      {/* A wanted callout, not an empty section: where no engine exists, that
          absence is the most useful thing the page can say. */}
      {
        g.wanted && (
          <div class="wanted">
            <p>{g.wanted}</p>
          </div>
        )
      }

      {
        projects.length > 0 && (
          <div class="engines">
            {projects.map((project) => (
              <EngineCard project={project} />
            ))}
          </div>
        )
      }
    </section>

    {/*
      "How to play it today" — masterdoc §4 lists it as part of the per-game
      hub and the design pass dropped it. It sits directly under the engines
      because it answers the question they raise: every one of them ships
      code and no assets, so a copy of the original is the prerequisite.
    */}
    <section class="section block">
      <h2 class="section-heading">How to play it today</h2>

      {
        projects.length > 0 && (
          <p class="play__prereq">
            Every engine above needs a copy of the original game. They ship code, not assets — none
            of them is a way to play {g.shortTitle} without owning it.
          </p>
        )
      }

      <ul class="stores">
        {
          g.storefronts.map((store) => (
            <li>
              <a class="store" href={store.url} target="_blank" rel="noopener noreferrer">
                <span class="store__name">{store.store} ↗</span>
                <span class="store__edition">{store.edition}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="play__note">{g.playNote}</p>

      <ul class="compat">
        {
          g.compat.map((entry) => (
            <li class="compat__item">
              <a class="compat__link" href={entry.url} target="_blank" rel="noopener noreferrer">
                {entry.title} ↗
              </a>
              <span class="compat__note">{entry.note}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section block block--last">
      <h2 class="section-heading">Community</h2>
      <div class="community-grid">
        {links.map((link) => <CommunityCard link={link} />)}
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-block: 64px 8px;
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .hero__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid var(--color-divider);
    flex: none;
  }

  .hero__kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .hero__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(30px, 5vw, 46px);
    margin: 0 0 16px;
    border-bottom: 3px solid;
    padding-bottom: 16px;
    display: inline-block;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 14px;
    margin: 18px 0 20px;
    font-size: 13px;
  }

  .facts dt {
    color: var(--color-text-dim);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 3px;
  }

  .facts dd {
    margin: 0;
  }

  .hero__credits {
    font-size: 13px;
    color: var(--color-text-dim);
    margin: 0 0 18px;
  }

  .hero__note {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text-dim);
    max-width: 70ch;
    margin: 0;
  }

  .shot {
    padding-block: 8px;
  }

  .shot__figure {
    margin: 0;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
  }

  .shot__figure img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .shot__figure figcaption {
    padding: 8px 14px;
    font-size: 11px;
    color: var(--color-text-dim);
    border-top: 1px solid var(--color-divider);
  }

  .block {
    padding-block: 36px 8px;
  }

  .block--last {
    padding-bottom: 72px;
  }

  .format {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 12px 16px;
    border-top: 1px solid var(--color-divider);
    flex-wrap: wrap;
  }

  .format:first-child {
    border-top: 0;
  }

  .format__label {
    display: flex;
    gap: 10px;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .format__name {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
  }

  .format__link {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .format__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .format__note {
    font-size: 12.5px;
    color: var(--color-text-dim);
  }

  .wanted {
    border: 1.5px dashed var(--color-divider);
    border-radius: var(--radius-lg);
    padding: 20px 22px;
  }

  .wanted p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-text-dim);
  }

  .engines {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* A long two-column list: role on the left, names running on the right.
     Roles are mono because they are labels being scanned, names are body
     text because they are read. */
  .credits {
    margin: 0;
    border-top: 1px solid var(--color-divider);
  }

  /* A studio or an expansion, heading the run of roles that belongs to it.
     Set in the heading face rather than mono: it names a team, not a field. */
  .credits__section {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 14px;
    margin: 26px 0 10px;
    color: var(--color-text);
  }

  .credits__row {
    display: grid;
    grid-template-columns: minmax(150px, 230px) 1fr;
    gap: 4px 24px;
    padding: 9px 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .credits dt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    padding-top: 2px;
  }

  .credits dd {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
  }

  .credits__meta {
    margin: 14px 0 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-text-dim);
    max-width: 70ch;
  }

  .credits__meta a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .credits__meta a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .credits__row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  .buildings-link {
    display: block;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    padding: 16px 18px;
    text-decoration: none;
  }

  .buildings-link:hover {
    border-color: var(--color-accent-dim);
  }

  .buildings-link__count {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-accent);
    margin-bottom: 5px;
  }

  .buildings-link__note {
    display: block;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-dim);
    max-width: 70ch;
  }

  .play__prereq {
    margin: 0 0 14px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-text-dim);
    max-width: 70ch;
  }

  .stores {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Outlined, never filled — the design draws with borders throughout. */
  .store {
    display: block;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    padding: 10px 16px;
    text-decoration: none;
    color: var(--color-text);
  }

  .store:hover {
    border-color: var(--color-accent-dim);
  }

  .store__name {
    display: block;
    font-size: 13px;
    color: var(--color-accent);
  }

  .store__edition {
    display: block;
    font-size: 12px;
    color: var(--color-text-dim);
    margin-top: 2px;
  }

  .play__note {
    margin: 14px 0 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--color-text-dim);
    max-width: 70ch;
  }

  .compat {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    border-top: 1px solid var(--color-divider);
  }

  .compat__item {
    display: flex;
    gap: 10px;
    align-items: baseline;
    flex-wrap: wrap;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .compat__link {
    font-size: 13px;
    color: var(--color-accent);
    text-decoration: none;
    flex: none;
  }

  .compat__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .compat__note {
    font-size: 12.5px;
    color: var(--color-text-dim);
  }

  .community-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: 40px 8px;
    }
  }
</style>
