---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);

const studios = [
  { years: '1990–2002', name: 'Impressions Games' },
  { years: '2002', name: 'BreakAway Games' },
  { years: '2004–2006', name: 'Tilted Mill' },
];
---

<Base
  title="Impressions Games Archive"
  description="A reference and modding archive for the Impressions Games / Sierra City Building series — Caesar, Caesar II, Caesar III, Pharaoh, Zeus and Emperor — their file formats, and the open-source engines keeping them running."
>
  <div data-pagefind-body>
    <section class="section section--wide hero">
      <div class="hero__kicker">A reference &amp; modding archive</div>
      <h1 class="hero__title">Impressions Games Archive</h1>
      <p class="hero__lede">
        Everything worth knowing about Caesar, Caesar&nbsp;II, Caesar&nbsp;III, Pharaoh, Zeus, and
        Emperor — the games, their file formats, and the open-source engines keeping them running
        today.
      </p>
      {/*
        Required by the build brief and by masterdoc §8, and absent from the
        design's hero. "Archive" sets an expectation of hosted files; the IP is
        actively held and actively licensed, so the scope is stated on the
        homepage rather than left to be discovered.
      */}
      <p class="hero__scope">
        An archive of knowledge and links — not of game files. Nothing here is a download of the
        games themselves.
      </p>
    </section>

    <section id="timeline" class="section">
      <h2 class="timeline__heading">The series, 1992 → 2023</h2>

      <div class="studios">
        {
          studios.map((studio) => (
            <div class="studios__cell">
              <div class="studios__years">{studio.years}</div>
              <div class="studios__name">{studio.name}</div>
            </div>
          ))
        }
      </div>

      <ol class="timeline">
        {
          games.map((game) => (
            <li class="timeline__item">
              <span
                class:list={['timeline__dot', { 'timeline__dot--ring': game.data.badgeAccent }]}
                style={`background:${game.data.accent}`}
                aria-hidden="true"
              />
              <div class="timeline__row">
                <a class="timeline__cover-link" href={withBase(`/${game.id}/`)} tabindex="-1" aria-hidden="true">
                  <img
                    class="timeline__cover"
                    src={withBase(game.data.cover)}
                    alt=""
                    title={game.data.coverCredit}
                    width="64"
                    height="96"
                    loading="lazy"
                  />
                </a>
                <div>
                  <div class="timeline__head">
                    <span class="timeline__year">{game.data.releaseYear}</span>
                    <a class="timeline__title" href={withBase(`/${game.id}/`)}>
                      {game.data.title}
                    </a>
                    <span class:list={['pill', { 'pill--accent': game.data.badgeAccent }]}>
                      {game.data.badge}
                    </span>
                  </div>
                  <p class="timeline__note">{game.data.timelineNote}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section related">
      <p class="related__line">
        <span class="related__label">Related, not core</span> — Caesar IV (2006) · Children of the
        Nile (2004) · Pharaoh: A New Era (2023) · Nebuchadnezzar (2021, spiritual successor)
      </p>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-block: 88px 56px;
  }

  .hero__kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.01em;
    margin: 0 0 22px;
    max-width: 14ch;
  }

  .hero__lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-text-dim);
    max-width: 640px;
    margin: 0 0 14px;
  }

  .hero__scope {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-dim);
    max-width: 640px;
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--color-divider);
  }

  .timeline__heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 0 0 22px;
  }

  .studios {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 32px;
  }

  .studios__cell {
    padding: 14px 18px;
    border-right: 1px solid var(--color-divider);
  }

  .studios__cell:last-child {
    border-right: 0;
  }

  .studios__years {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 4px;
  }

  .studios__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 15px;
  }

  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 28px;
    border-left: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .timeline__item {
    position: relative;
  }

  .timeline__dot {
    position: absolute;
    left: -33px;
    top: 2px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid var(--color-divider);
  }

  /* Caesar III, the archetype, gets the halo the design gives it. */
  .timeline__dot--ring {
    box-shadow: 0 0 0 3px oklch(97% 0.003 60 / 0.2);
  }

  .timeline__row {
    display: flex;
    gap: 14px;
  }

  .timeline__cover-link {
    flex: none;
  }

  .timeline__cover {
    display: block;
    width: 64px;
    height: 96px;
    object-fit: cover;
    border-radius: 3px;
    border: 1px solid var(--color-divider);
  }

  .timeline__head {
    display: flex;
    gap: 12px;
    align-items: baseline;
    flex-wrap: wrap;
    margin-bottom: 5px;
  }

  .timeline__year {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-dim);
  }

  .timeline__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 19px;
    color: var(--color-text);
    text-decoration: none;
  }

  .timeline__title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .timeline__note {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-text-dim);
    max-width: 64ch;
  }

  .related {
    padding-bottom: 72px;
  }

  .related__line {
    border-top: 1px solid var(--color-divider);
    padding-top: 20px;
    margin: 0;
    font-style: italic;
    font-size: 13px;
    color: var(--color-text-dim);
  }

  .related__label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-style: normal;
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: 56px 40px;
    }

    .studios {
      grid-template-columns: 1fr;
    }

    .studios__cell {
      border-right: 0;
      border-bottom: 1px solid var(--color-divider);
    }

    .studios__cell:last-child {
      border-bottom: 0;
    }
  }
</style>
