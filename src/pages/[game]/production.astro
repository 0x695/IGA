---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';

/**
 * A game's production chains.
 *
 * What goes in, what comes out, and how fast - read out of the engine rather
 * than timed in play, which matters because every published figure for this
 * elsewhere is somebody's stopwatch.
 */
export async function getStaticPaths() {
  const games = await getCollection('games');
  const production = await getCollection('production');

  return games
    .map((game) => ({
      game,
      rows: production
        .filter((p) => p.data.game === game.id)
        .sort((a, b) => a.data.name.localeCompare(b.data.name)),
    }))
    .filter(({ rows }) => rows.length > 0)
    .map(({ game, rows }) => ({ params: { game: game.id }, props: { game, rows } }));
}

const { game, rows } = Astro.props;
const g = game.data;

/* Raw producers and workshops are different things and the difference is the
   whole shape of a city's economy, so they are separate tables. */
const raw = rows.filter((r) => r.data.inputs.length === 0);
const workshops = rows.filter((r) => r.data.inputs.length > 0);
const groups = [
  { name: 'Raw materials', rows: raw },
  { name: 'Workshops', rows: workshops },
].filter((group) => group.rows.length > 0);

/* Each game's numbers come from the reimplementation that covers it, and
   none of the three are quite the same shape (see the file-level comment in
   scripts/build-production.mjs): Akhenaten steps a literal progress bar and
   states rate/full/difficulty outright; eZeus consumes raw material on a
   timer with no per-step increment at all, so rate/full stay dashes for
   every Zeus row; Julius's progress threshold (full) is a real engine
   constant but the per-day rate is however many workers are currently
   employed, not a fixed figure, so Caesar III publishes full but not rate. */
const SOURCE: Record<string, { label: string; url: string }> = {
  pharaoh: {
    label: "Akhenaten's building configuration",
    url: 'https://github.com/dalerank/Akhenaten/tree/master/src/scripts/building',
  },
  zeus: {
    label: "eZeus's own building source",
    url: 'https://github.com/MaurycyLiebner/eZeus/tree/main/buildings',
  },
  caesar3: {
    label: "Julius's own building source",
    url: 'https://github.com/bvschaik/julius/blob/master/src/building/industry.c',
  },
  caesar2: {
    label: "the game's own manual (no engine table exists to read)",
    url: 'https://0x695.github.io/IGA/manuals/caesar2.pdf',
  },
};
const source = SOURCE[game.id];
---

<Base
  title={`${g.title} production chains — Impressions Games Archive`}
  description={`What every ${g.title} industry building consumes and produces, and how fast.`}
  current={game.id}
>
  <div data-pagefind-body>
    <section class="section head">
      <p class="head__kicker">
        <a href={withBase(`/${game.id}/`)}>{g.title}</a>
        <span aria-hidden="true"> · </span>Production
      </p>
      <h1 class="head__title">Production chains</h1>
      <p class="head__summary">
        Every building that makes something: what it takes in, what it puts out, how many labourers
        it wants, and — where the source states it in a shape this page can stand behind — the rate
        the engine steps its progress bar with. Read out of {source.label} rather than timed in play.
      </p>

      <aside class="caveat">
        <h2 class="caveat__title">How to read the rate</h2>
        <p>
          A building adds its <strong>rate</strong> to a progress counter each step, and finishes one
          load when that counter reaches <strong>full</strong>. The brickworks is the clearest case:
          20 per step against 400, so twenty steps a load. The two columns only mean something
          together — a rate of 100 against 200 is five times quicker than 20 against 400, though the
          bigger number belongs to the slower building. <strong>Difficulty</strong> is the percentage
          of that rate actually applied, and it is the same five-value shape as building cost: full
          speed on the gentlest setting, half on the hardest.
        </p>
        <p>
          A dash means the source does not state that field — some buildings take their timing from
          engine defaults rather than from their own file, and inventing a number for them would be
          worse than the gap.
        </p>
        {
          game.id === 'zeus' && (
            <p>
              Every rate and full cell on this page is a dash, and that one's a wider gap than "not
              stated": eZeus's processing buildings consume a fixed amount of raw material every
              fixed number of ticks, with no per-step progress bar at all, so Pharaoh's two columns
              have nothing to read a value from. eZeus is also explicitly not byte-exact against the
              original, so even its own timing constants would be the reimplementation's
              approximation, not a verified reproduction. What takes/makes, footprint and staff are
              read the same way as Pharaoh's and carry the same confidence.
            </p>
          )
        }
        {
          game.id === 'caesar3' && (
            <p>
              Full is real here — <code>MAX_PROGRESS_RAW</code> and <code>MAX_PROGRESS_WORKSHOP</code>{' '}
              are literal constants in Julius's own source, 200 and 400, not a value c3_model.txt can
              move. Rate is the gap: the engine adds a building's current worker count to its progress
              every day, not a fixed number, so the true rate changes with how fully staffed a
              building happens to be at the cap c3_model.txt sets for it — a real quantity, just not
              one this page can state as a single figure. The marble quarry is the one outlier worth
              naming directly: it accrues progress at half that rate, a genuine special case in the
              source rather than a rounding choice, so it reaches the same 200 threshold roughly twice
              as slowly as every other raw producer at equal staffing.
            </p>
          )
        }
        {
          game.id === 'caesar2' && (
            <p>
              No engine table exists for this page to read at all — Caesar II's decompilation names a
              business only by a raw-material index, never in English, because those names live in the
              game's own text resource rather than compiled into the binary. Every figure here comes
              from the manual's Appendix instead, which names sixteen businesses and each one's raw
              material but never the finished good's own name — for five of them (Bakery, Winery,
              Butcher, Pottery Works, Glass Works) that name is just the business's own name read as
              plain English, so they're rows here. The other eleven are exactly as real — Lumber Mill,
              Jeweler, Lead Works, Iron Works, Copper Works, Marble Works, Stone Works, Silk Dealer,
              Spice Dealer, Ivory Dealer, Fish Monger, each with a stated raw material — but "Works" and
              "Dealer" don't say on their own whether the business refines the material or simply
              resells it unchanged, and guessing would read as sourced when it isn't. Size, staff and
              rate are absent for the same reason as everything else on this page: the manual states
              only that "the maximum output of a business is seven jars" (p.31), a storage cap that
              applies to none of them by name.
            </p>
          )
        }
        <p class="caveat__sources">
          <a href={source.url} target="_blank" rel="noopener noreferrer">
            {source.label} ↗
          </a>
        </p>
      </aside>
    </section>

    <section class="section list">
      {
        groups.map((group) => (
          <>
            <h2 class="group">{group.name}</h2>
            <div class="scroller">
              <table class="chains">
                <thead>
                  <tr>
                    <th>Building</th>
                    <th>Takes</th>
                    <th>Makes</th>
                    <th class="num">Size</th>
                    <th class="num">Workers</th>
                    <th class="num">Rate</th>
                    <th class="num">Full</th>
                    <th class="num">Difficulty %</th>
                  </tr>
                </thead>
                <tbody>
                  {group.rows.map((row) => (
                    <tr>
                      <th scope="row" class="name">
                        {row.data.name}
                        <code>{row.data.engineType}</code>
                      </th>
                      <td class="res">
                        {row.data.inputs.length ? row.data.inputs.join(' + ') : '—'}
                      </td>
                      <td class="res out">{row.data.output}</td>
                      <td class="num">
                        {row.data.size ? `${row.data.size}×${row.data.size}` : '—'}
                      </td>
                      <td class="num">{row.data.laborers ?? '—'}</td>
                      <td class="num">{row.data.productionRate ?? '—'}</td>
                      <td class="num">{row.data.progressMax ?? '—'}</td>
                      <td class="num dim">{row.data.rateByDifficulty?.join(' · ') ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .head {
    padding-block: 56px 0;
  }

  .head__kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 0 0 14px;
  }

  .head__kicker a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .head__kicker a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .head__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(30px, 5vw, 46px);
    margin: 0 0 18px;
    padding-bottom: 16px;
    border-bottom: 3px solid var(--color-divider);
    display: inline-block;
  }

  .head__summary {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text-dim);
    max-width: 70ch;
    margin: 0 0 24px;
  }

  .caveat {
    border: 1px solid var(--color-divider);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: 16px 20px;
  }

  .caveat__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 15px;
    margin: 0 0 6px;
  }

  .caveat p {
    margin: 0 0 8px;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-text-dim);
    max-width: 70ch;
  }

  .caveat p:last-child {
    margin-bottom: 0;
  }

  .caveat strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .caveat__sources {
    margin-top: 10px !important;
    font-size: 12.5px;
  }

  .caveat__sources a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .caveat__sources a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .list {
    padding-block: 36px 80px;
  }

  .group {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 34px 0 12px;
  }

  .group:first-child {
    margin-top: 0;
  }

  .scroller {
    overflow-x: auto;
  }

  .chains {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .chains th,
  .chains td {
    text-align: left;
    padding: 9px 10px;
    border-bottom: 1px solid var(--color-divider);
    vertical-align: baseline;
  }

  .chains thead th {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    font-weight: 400;
    white-space: nowrap;
    border-bottom-color: var(--color-text-dim);
  }

  .name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
  }

  .name code {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    color: var(--color-text-dim);
    opacity: 0.75;
    margin-top: 2px;
  }

  .res {
    font-size: 12.5px;
    color: var(--color-text-dim);
    white-space: nowrap;
  }

  .out {
    color: var(--color-text);
  }

  /* Mono only where a value is compared character by character. */
  .num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    text-align: right !important;
    white-space: nowrap;
  }

  .dim {
    color: var(--color-text-dim);
  }

  @media (max-width: 640px) {
    .head {
      padding-block: 36px 0;
    }
  }
</style>
