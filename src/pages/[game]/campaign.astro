---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';

/**
 * A game's campaign, mission by mission.
 *
 * Only games with data get a route, and each page states where its data came
 * from, because that differs: Pharaoh is read from Akhenaten's own per-mission
 * config and therefore carries the win criteria the code checks, while Caesar
 * III, Emperor and Zeus are community documentation and carry names and order
 * only. Presenting the two as if they were equally grounded would be the
 * dishonest part.
 */
export async function getStaticPaths() {
  const games = await getCollection('games');
  const missions = await getCollection('campaigns');

  return games
    .map((game) => ({
      game,
      missions: missions
        .filter((m) => m.data.game === game.id)
        .sort((a, b) => a.data.order - b.data.order),
    }))
    .filter(({ missions }) => missions.length > 0)
    .map(({ game, missions }) => ({ params: { game: game.id }, props: { game, missions } }));
}

const { game, missions } = Astro.props;
const g = game.data;

/*
 * Missions are grouped by the campaign they belong to, in play order.
 *
 * Zeus is numbered inside its group rather than across the whole list: its
 * thirteen adventures are independent runs, not one sequence, so a counter
 * that ran from 1 to 93 across them would assert an order the game does not
 * have.
 */
const numberWithinGroup = game.id === 'zeus';
/* Caesar II's provinces have no play order to number - you choose. */
const numbered = game.id !== 'caesar2';
const groups: { name: string; missions: typeof missions }[] = [];
for (const mission of missions) {
  const last = groups.at(-1);
  if (last && last.name === mission.data.campaign) last.missions.push(mission);
  else groups.push({ name: mission.data.campaign, missions: [mission] });
}

const total = missions.length;

/*
 * Where each list comes from. Pharaoh's is read from the engine and carries
 * the criteria the code tests; the other two are community documentation,
 * because mission names are not in those engines at all. Saying which is
 * which is the difference between a reference and a list of words.
 */
const PROVENANCE: Record<
  string,
  { summary: string; caveat: string; sources: { title: string; url: string | null }[] }
> = {
  pharaoh: {
    summary:
      "All 53 missions in play order, with the rank you hold and the goals the game checks to end them. Thirty-eight are the base campaign; the remaining fifteen are Cleopatra: Queen of the Nile, which is four short campaigns rather than one. Read out of Akhenaten's per-mission configuration rather than from a walkthrough, so these are the thresholds the engine actually tests.",
    caveat:
      'Win criteria, not advice. The table says what the game requires; it does not say how to get there, and a mission with modest-looking goals can still be the hard one. Housing level is the rung on the twenty-step housing ladder, not a count of houses - those are listed separately where a mission demands them. The campaign each mission belongs to is not guessed either: every mission names the one it hands off to, and a campaign ends where that pointer does, which is what separates the four Cleopatra campaigns from each other and from the base game.',
    sources: [
      { title: 'Akhenaten - src/scripts/mission/', url: 'https://github.com/dalerank/Akhenaten/tree/master/src/scripts/mission' },
    ],
  },
  caesar1: {
    summary:
      'Nineteen ranks, and the ratings each one demands before Rome promotes you. Caesar has no mission list - it assigns you a province at random, nineteen times in a row, and generates the map - so the campaign is the ladder rather than the places.',
    caveat:
      "Ratings, not maps. Each rank names the minimum any single rating may fall to and the average all of them must reach, and both climb the whole way up; the provinces themselves are generated, so no two runs govern the same places. The twentieth title, Caesar, is the win rather than another province. This is community documentation of the US DOS release, which differs from the EU one in mechanics and balance.",
    sources: [
      { title: "A player's tutorial for the US DOS release of Caesar", url: null },
    ],
  },
  caesar2: {
    summary:
      'Thirty-two provinces. Caesar II is not a mission list either: you start in Latium and civilize provinces outward, each one unlocking its neighbours, and how far you must get before you are made Caesar depends on the difficulty you chose.',
    caveat:
      "Not an order. These are the provinces the game can give you, not a sequence to play through - which you take, and when, is for you and your rival Pompous Maximus to settle between you, so they are listed unnumbered. The four Exterior provinces are separated because they belong to the higher difficulties. Names only: there is no open-source Caesar II engine, and no format documentation for the game at all.",
    sources: [
      { title: "A community FAQ/guide for Caesar II, version 1.0", url: null },
    ],
  },
  caesar3: {
    summary:
      'Twenty missions across eleven ranks. From the third rank onward the emperor offers two provinces - one peaceful, one under military threat - and you play one of them, so a single run sees twelve of these twenty maps.',
    caveat:
      "No win criteria here. Caesar III's mission names are not in the engine at all - they live in the game's own text files - so this list is community documentation rather than something read from code. The rank-and-branch pairing below is agreed independently by two sources, and the count reconciles with Julius, which uses eleven of the twelve rows in its mission table.",
    sources: [
      { title: 'Caesar 3 Heaven - military walkthroughs index', url: 'https://caesar3.heavengames.com/strategy/militarywalk/index.shtml' },
      { title: 'Impressions Games Wiki - Caesar 3 missions', url: 'https://impressionsgames.fandom.com/wiki/Category:Caesar_3:_Missions' },
    ],
  },
  emperor: {
    summary:
      'Forty-eight missions in play order, grouped by the dynasty each belongs to, from the Xia tutorials to the Song-Jin. Emperor has no engine reimplementation, so unlike the others this list could only come from the community.',
    caveat:
      "Names and order only. Emperor is the one game in the series with no open-source engine to read, which is exactly why its wanted callout exists - so there is no code to check these against, and no win criteria to publish. The dynasty grouping is no longer guesswork: a second source lists the same forty-eight missions in the same order under its own dynasty headings, and the two agree at every position. They differ on two spellings, where this list keeps the wiki's - Xianyang was the Qin capital, and Zhengzhou the Shang city.",
    sources: [
      { title: 'Impressions Games Wiki - Emperor missions', url: 'https://impressionsgames.fandom.com/wiki/Category:Emperor:_Missions' },
      { title: "Mike Jenista's Emperor: Rise of the Middle Kingdom FAQ/Walkthrough, v1.00", url: null },
    ],
  },
  zeus: {
    summary:
      'Thirteen adventures - seven in the base game, six added by Poseidon: Master of Atlantis - and the episodes inside each, in play order. Zeus does not have a mission list the way Caesar III and Pharaoh do: it has adventures, and an adventure is a run of episodes that carries your treasury forward from one to the next.',
    caveat:
      "Names and order only, and from a single walkthrough rather than from code - there is no open-source Zeus engine to read. Two adventures list one episode more than you will play, because each offers a choice of colony and you take one of the two; those four are marked as a choice rather than as peaceful or military, which is Caesar III's split and not this game's. Where two episodes in an adventure share a title they are numbered here, and no win criteria are published, because a walkthrough's stated goals are its author's reading rather than something checkable.",
    sources: [
      { title: "Red Phoenix's Zeus: Master of Olympus and Poseidon walkthrough", url: null },
    ],
  },
};

const provenance = PROVENANCE[game.id];
const showRank = missions.some((m) => m.data.rank !== null);
---

<Base
  title={`${g.title} campaign — Impressions Games Archive`}
  description={`All ${total} missions of the ${g.title} campaign, in play order.`}
  current={game.id}
>
  <div data-pagefind-body>
    <section class="section head">
      <p class="head__kicker">
        <a href={withBase(`/${game.id}/`)}>{g.title}</a>
        <span aria-hidden="true"> · </span>Campaign
      </p>
      <h1 class="head__title">Campaign</h1>
      <p class="head__summary">{provenance.summary}</p>

      <aside class="caveat">
        <h2 class="caveat__title">Where this comes from</h2>
        <p>{provenance.caveat}</p>
        <p class="caveat__sources">
          {
            provenance.sources.map((source, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> · </span>}
                {source.url ? (
                  <a href={source.url} rel="noopener">{source.title} ↗</a>
                ) : (
                  <span>{source.title}</span>
                )}
              </>
            ))
          }
        </p>
      </aside>
    </section>

    <section class="section list">
      {
        groups.map((group) => (
          <>
            <h2 class="group">{group.name}</h2>
            <ol class="missions">
              {group.missions.map((mission) => (
                <li class="mission">
                  <div class="mission__head">
                    {numbered && (
                      <span class="mission__num">
                        {String(
                          numberWithinGroup
                            ? group.missions.indexOf(mission) + 1
                            : mission.data.order,
                        ).padStart(2, '0')}
                      </span>
                    )}
                    <span class="mission__name">{mission.data.name}</span>
                    {mission.data.rankName && (
                      <span class="mission__rank">{mission.data.rankName}</span>
                    )}
                    {mission.data.branch && (
                      <span class:list={['mission__branch', `mission__branch--${mission.data.branch}`]}>
                        {mission.data.branch}
                      </span>
                    )}
                    {!mission.data.rankName && showRank && mission.data.rank !== null && (
                      <span class="mission__rank">Rank {mission.data.rank}</span>
                    )}
                  </div>
                  <ul class="goals">
                    {mission.data.goals.map((goal) => (
                      <li class="goal">
                        <span class="goal__label">{goal.label}</span>
                        <span class="goal__value">{goal.value.toLocaleString('en-GB')}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          </>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .head {
    padding-block: 56px 0;
  }

  .head__kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 0 0 14px;
  }

  .head__kicker a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .head__kicker a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .head__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(30px, 5vw, 46px);
    margin: 0 0 18px;
    padding-bottom: 16px;
    border-bottom: 3px solid var(--color-divider);
    display: inline-block;
  }

  .head__summary {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text-dim);
    max-width: 70ch;
    margin: 0 0 24px;
  }

  .caveat {
    border: 1px solid var(--color-divider);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: 16px 20px;
  }

  .caveat__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 15px;
    margin: 0 0 6px;
  }

  .caveat p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-text-dim);
    max-width: 70ch;
  }

  .list {
    padding-block: 36px 80px;
  }

  .group {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 32px 0 14px;
  }

  .group:first-child {
    margin-top: 0;
  }

  .missions {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-divider);
  }

  .mission {
    padding: 14px 0;
    border-bottom: 1px solid var(--color-divider);
    display: grid;
    grid-template-columns: minmax(220px, 300px) 1fr;
    gap: 8px 24px;
    align-items: baseline;
  }

  .mission__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .mission__num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .mission__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 16px;
  }

  .mission__rank {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    border: 1px solid var(--color-divider);
    border-radius: 3px;
    padding: 1px 6px;
    white-space: nowrap;
  }

  .mission__branch {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 3px;
    padding: 1px 6px;
    white-space: nowrap;
    border: 1px solid var(--color-divider);
    color: var(--color-text-dim);
  }

  /* The two branches are a real fork in the campaign, so they are marked -
     but with the site's own vocabulary, not a fifth colour. */
  .mission__branch--military {
    color: var(--accent-rome);
    border-color: var(--accent-rome-dim);
  }

  .caveat__sources {
    margin-top: 10px !important;
    font-size: 12.5px;
  }

  .caveat__sources a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .caveat__sources a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .goals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
  }

  .goal {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 12.5px;
  }

  .goal__label {
    color: var(--color-text-dim);
  }

  .goal__value {
    font-family: var(--font-mono);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .mission {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .head {
      padding-block: 36px 0;
    }
  }
</style>
